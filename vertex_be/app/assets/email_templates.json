{
  "email_verification": {
    "event": "welcome",
    "subject": "Verify your Vertex International account",
    "html": "\n  <div style=\"background:#f5f1e8;padding:32px 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\">\n    <div style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid rgba(6,33,25,0.08);\">\n      <div style=\"background:#03120d;padding:36px 40px 32px;\">\n        <table role=\"presentation\" style=\"border-collapse:collapse;\">\n          <tr>\n            <td style=\"vertical-align:middle;padding-right:10px;\">\n              <img src=\"{{logo}}\" width=\"26\" height=\"26\" alt=\"\" style=\"display:block;border-radius:6px;\" />\n            </td>\n            <td style=\"vertical-align:middle;\">\n              <span style=\"font-size:14px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#fbf9f4;\">VERTEX <span style=\"color:#d4af5c;\">INTERNATIONAL</span></span>\n            </td>\n          </tr>\n        </table>\n        <div style=\"margin-top:24px;font-size:11px;font-weight:700;letter-spacing:0.25em;text-transform:uppercase;color:#d4af5c;\">Account Verification</div>\n        <div style=\"margin-top:10px;font-size:24px;font-weight:600;letter-spacing:-0.01em;color:#fbf9f4;line-height:1.25;\">Welcome, {{fullName}}.</div>\n        \n      </div>\n      <div style=\"padding:36px 40px;background:#ffffff;\">\n        \n      <p style=\"font-size:15px;color:#062119;line-height:1.65;margin:0 0 20px;\">Thank you for registering with Vertex International Recruitment. Please verify your email address to activate your account.</p>\n      <div style=\"text-align:center;margin:28px 0 8px;\">\n    <a href=\"{{verifyUrl}}\" style=\"display:inline-block;background:#d4af5c;color:#03120d;padding:14px 32px;border-radius:999px;text-decoration:none;font-weight:600;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;\">Verify Email Address</a>\n  </div>\n      <p style=\"font-size:13px;color:rgba(6,33,25,0.55);line-height:1.5;margin:0;\">This link expires in 24 hours. If you did not create an account, you can ignore this email.</p>\n    \n      </div>\n      <div style=\"padding:24px 40px;background:#f5f1e8;border-top:1px solid rgba(6,33,25,0.08);\">\n        <div style=\"font-size:12px;color:rgba(6,33,25,0.55);line-height:1.6;\">\n          Vertex International Recruitment Ltd.<br />5 Brayford Square, London, E1 0SG, United Kingdom\n        </div>\n        <div style=\"font-size:11px;color:rgba(6,33,25,0.4);margin-top:10px;\">\n          © {{year}} Vertex International Recruitment. All rights reserved.\n        </div>\n      </div>\n    </div>\n  </div>"
  },
  "password_reset": {
    "event": "reset_password",
    "subject": "Reset your Vertex International password",
    "html": "\n  <div style=\"background:#f5f1e8;padding:32px 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\">\n    <div style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid rgba(6,33,25,0.08);\">\n      <div style=\"background:#03120d;padding:36px 40px 32px;\">\n        <table role=\"presentation\" style=\"border-collapse:collapse;\">\n          <tr>\n            <td style=\"vertical-align:middle;padding-right:10px;\">\n              <img src=\"{{logo}}\" width=\"26\" height=\"26\" alt=\"\" style=\"display:block;border-radius:6px;\" />\n            </td>\n            <td style=\"vertical-align:middle;\">\n              <span style=\"font-size:14px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#fbf9f4;\">VERTEX <span style=\"color:#d4af5c;\">INTERNATIONAL</span></span>\n            </td>\n          </tr>\n        </table>\n        <div style=\"margin-top:24px;font-size:11px;font-weight:700;letter-spacing:0.25em;text-transform:uppercase;color:#d4af5c;\">Account Security</div>\n        <div style=\"margin-top:10px;font-size:24px;font-weight:600;letter-spacing:-0.01em;color:#fbf9f4;line-height:1.25;\">Reset your password</div>\n        \n      </div>\n      <div style=\"padding:36px 40px;background:#ffffff;\">\n        \n      <p style=\"font-size:15px;color:#062119;line-height:1.65;margin:0 0 20px;\">Hi {{fullName}}, click the button below to reset your password.</p>\n      <div style=\"text-align:center;margin:28px 0 8px;\">\n    <a href=\"{{resetUrl}}\" style=\"display:inline-block;background:#d4af5c;color:#03120d;padding:14px 32px;border-radius:999px;text-decoration:none;font-weight:600;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;\">Reset Password</a>\n  </div>\n      <p style=\"font-size:13px;color:rgba(6,33,25,0.55);line-height:1.5;margin:0;\">This link expires in 24 hours. If you didn't request this, you can safely ignore this email.</p>\n    \n      </div>\n      <div style=\"padding:24px 40px;background:#f5f1e8;border-top:1px solid rgba(6,33,25,0.08);\">\n        <div style=\"font-size:12px;color:rgba(6,33,25,0.55);line-height:1.6;\">\n          Vertex International Recruitment Ltd.<br />5 Brayford Square, London, E1 0SG, United Kingdom\n        </div>\n        <div style=\"font-size:11px;color:rgba(6,33,25,0.4);margin-top:10px;\">\n          © {{year}} Vertex International Recruitment. All rights reserved.\n        </div>\n      </div>\n    </div>\n  </div>"
  },
  "account_setup": {
    "event": "account_setup_invite",
    "subject": "Set up your Vertex International account",
    "html": "\n  <div style=\"background:#f5f1e8;padding:32px 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\">\n    <div style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid rgba(6,33,25,0.08);\">\n      <div style=\"background:#03120d;padding:36px 40px 32px;\">\n        <table role=\"presentation\" style=\"border-collapse:collapse;\">\n          <tr>\n            <td style=\"vertical-align:middle;padding-right:10px;\">\n              <img src=\"{{logo}}\" width=\"26\" height=\"26\" alt=\"\" style=\"display:block;border-radius:6px;\" />\n            </td>\n            <td style=\"vertical-align:middle;\">\n              <span style=\"font-size:14px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#fbf9f4;\">VERTEX <span style=\"color:#d4af5c;\">INTERNATIONAL</span></span>\n            </td>\n          </tr>\n        </table>\n        <div style=\"margin-top:24px;font-size:11px;font-weight:700;letter-spacing:0.25em;text-transform:uppercase;color:#d4af5c;\">Account Setup</div>\n        <div style=\"margin-top:10px;font-size:24px;font-weight:600;letter-spacing:-0.01em;color:#fbf9f4;line-height:1.25;\">Set up your account, {{name}}.</div>\n        \n      </div>\n      <div style=\"padding:36px 40px;background:#ffffff;\">\n        \n      <p style=\"font-size:15px;color:#062119;line-height:1.65;margin:0 0 20px;\">An account has been created for you on Vertex International. Set your password to get started.</p>\n      <div style=\"text-align:center;margin:28px 0 8px;\">\n    <a href=\"{{setupUrl}}\" style=\"display:inline-block;background:#d4af5c;color:#03120d;padding:14px 32px;border-radius:999px;text-decoration:none;font-weight:600;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;\">Set Your Password</a>\n  </div>\n      <p style=\"font-size:13px;color:rgba(6,33,25,0.55);line-height:1.5;margin:0;\">This link expires in 7 days.</p>\n    \n      </div>\n      <div style=\"padding:24px 40px;background:#f5f1e8;border-top:1px solid rgba(6,33,25,0.08);\">\n        <div style=\"font-size:12px;color:rgba(6,33,25,0.55);line-height:1.6;\">\n          Vertex International Recruitment Ltd.<br />5 Brayford Square, London, E1 0SG, United Kingdom\n        </div>\n        <div style=\"font-size:11px;color:rgba(6,33,25,0.4);margin-top:10px;\">\n          © {{year}} Vertex International Recruitment. All rights reserved.\n        </div>\n      </div>\n    </div>\n  </div>"
  },
  "candidate_invite": {
    "event": "candidate_invite",
    "subject": "You're ready to apply — create your Vertex account",
    "html": "\n  <div style=\"background:#f5f1e8;padding:32px 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\">\n    <div style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid rgba(6,33,25,0.08);\">\n      <div style=\"background:#03120d;padding:36px 40px 32px;\">\n        <table role=\"presentation\" style=\"border-collapse:collapse;\">\n          <tr>\n            <td style=\"vertical-align:middle;padding-right:10px;\">\n              <img src=\"{{logo}}\" width=\"26\" height=\"26\" alt=\"\" style=\"display:block;border-radius:6px;\" />\n            </td>\n            <td style=\"vertical-align:middle;\">\n              <span style=\"font-size:14px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#fbf9f4;\">VERTEX <span style=\"color:#d4af5c;\">INTERNATIONAL</span></span>\n            </td>\n          </tr>\n        </table>\n        <div style=\"margin-top:24px;font-size:11px;font-weight:700;letter-spacing:0.25em;text-transform:uppercase;color:#d4af5c;\">Next Step</div>\n        <div style=\"margin-top:10px;font-size:24px;font-weight:600;letter-spacing:-0.01em;color:#fbf9f4;line-height:1.25;\">You're a step closer, {{name}}.</div>\n        \n      </div>\n      <div style=\"padding:36px 40px;background:#ffffff;\">\n        \n      <p style=\"font-size:15px;color:#062119;line-height:1.65;margin:0 0 20px;\">Your Vertex International recruiter has reviewed your details and confirmed you're ready for the next step. Create your own free account to browse available programmes and submit your application directly.</p>\n      <div style=\"text-align:center;margin:28px 0 8px;\">\n    <a href=\"{{registerUrl}}\" style=\"display:inline-block;background:#d4af5c;color:#03120d;padding:14px 32px;border-radius:999px;text-decoration:none;font-weight:600;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;\">Create My Account</a>\n  </div>\n      <p style=\"font-size:13px;color:rgba(6,33,25,0.55);line-height:1.5;margin:0;\">This link expires in 7 days. If you're not ready yet, your recruiter can still submit an application on your behalf.</p>\n    \n      </div>\n      <div style=\"padding:24px 40px;background:#f5f1e8;border-top:1px solid rgba(6,33,25,0.08);\">\n        <div style=\"font-size:12px;color:rgba(6,33,25,0.55);line-height:1.6;\">\n          Vertex International Recruitment Ltd.<br />5 Brayford Square, London, E1 0SG, United Kingdom\n        </div>\n        <div style=\"font-size:11px;color:rgba(6,33,25,0.4);margin-top:10px;\">\n          © {{year}} Vertex International Recruitment. All rights reserved.\n        </div>\n      </div>\n    </div>\n  </div>"
  },
  "referral_agent_application": {
    "event": null,
    "subject": "Verify your email — Vertex Referral Agent application",
    "html": "\n  <div style=\"background:#f5f1e8;padding:32px 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\">\n    <div style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid rgba(6,33,25,0.08);\">\n      <div style=\"background:#03120d;padding:36px 40px 32px;\">\n        <table role=\"presentation\" style=\"border-collapse:collapse;\">\n          <tr>\n            <td style=\"vertical-align:middle;padding-right:10px;\">\n              <img src=\"{{logo}}\" width=\"26\" height=\"26\" alt=\"\" style=\"display:block;border-radius:6px;\" />\n            </td>\n            <td style=\"vertical-align:middle;\">\n              <span style=\"font-size:14px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#fbf9f4;\">VERTEX <span style=\"color:#d4af5c;\">INTERNATIONAL</span></span>\n            </td>\n          </tr>\n        </table>\n        <div style=\"margin-top:24px;font-size:11px;font-weight:700;letter-spacing:0.25em;text-transform:uppercase;color:#d4af5c;\">Referral Agent</div>\n        <div style=\"margin-top:10px;font-size:24px;font-weight:600;letter-spacing:-0.01em;color:#fbf9f4;line-height:1.25;\">Application received</div>\n        \n      </div>\n      <div style=\"padding:36px 40px;background:#ffffff;\">\n        \n      <p style=\"font-size:15px;color:#062119;line-height:1.65;margin:0 0 20px;\">Hi {{fullName}}, thanks for applying to become a Vertex Referral Agent.</p>\n      <p style=\"font-size:15px;color:#062119;line-height:1.65;margin:0 0 20px;\">Please verify your email address to continue — this is required before we can review your application.</p>\n      <div style=\"text-align:center;margin:28px 0 8px;\">\n    <a href=\"{{verifyUrl}}\" style=\"display:inline-block;background:#d4af5c;color:#03120d;padding:14px 32px;border-radius:999px;text-decoration:none;font-weight:600;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;\">Verify Email</a>\n  </div>\n      <p style=\"font-size:13px;color:rgba(6,33,25,0.55);line-height:1.5;margin:0;\">Once verified, our team will review your application and let you know the outcome.</p>\n    \n      </div>\n      <div style=\"padding:24px 40px;background:#f5f1e8;border-top:1px solid rgba(6,33,25,0.08);\">\n        <div style=\"font-size:12px;color:rgba(6,33,25,0.55);line-height:1.6;\">\n          Vertex International Recruitment Ltd.<br />5 Brayford Square, London, E1 0SG, United Kingdom\n        </div>\n        <div style=\"font-size:11px;color:rgba(6,33,25,0.4);margin-top:10px;\">\n          © {{year}} Vertex International Recruitment. All rights reserved.\n        </div>\n      </div>\n    </div>\n  </div>"
  }
}
