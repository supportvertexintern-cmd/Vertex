# Repo-wide secret guard. No env file of any kind is committed, not even
# templates. gitleaks enforces this even for `git add -f` (see .gitleaks.toml and .pre-commit-config.yaml).
.env
.env.*

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Local databases and dumps
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
