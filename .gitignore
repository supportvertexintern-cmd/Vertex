# Repo-wide secret guard. No env file of any kind is committed, not even
# templates. gitleaks enforces this even for `git add -f` (see .gitleaks.toml and .pre-commit-config.yaml).
.env
.env.*

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Logs (build output and the like)
*.log

# Local databases and dumps
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# JUnit reports for tools/traceability.py (CI writes them; never committed)
junit-*.xml

# Python bytecode caches (tools/ runs outside vertex_be)
__pycache__/
