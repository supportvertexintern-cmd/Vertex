# Repo-wide secret guard. Real env files and keys never get committed; only
# placeholder templates (*.example) do. gitleaks enforces this even for
# `git add -f` (see .gitleaks.toml and .pre-commit-config.yaml).
.env
.env.*
!.env.example
!.env.*.example

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Local databases and dumps
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
